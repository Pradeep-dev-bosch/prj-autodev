# .env - Add to .gitignore!
TRACKER_URL=https://your_tracker_url_here
JIRA_TOKEN=your-jira-token-here

SHAREPOINT_URL=https://your_sharepoint_url_here
SHAREPOINT_USERNAME=your-sharepoint-username-here
SHAREPOINT_PASSWORD=your-sharepoint-password-here

GERRIT_URL=https://your_gerrit_url_here
GERRIT_USERNAME=your-gerrit-username-here
GERRIT_HTTP_PASSWORD=your-gerrit-http-password-here